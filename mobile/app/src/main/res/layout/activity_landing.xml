<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_red_bg">

    <!-- Decorative circle top-right -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-90dp"
        android:background="@drawable/bg_circle_decoration"
        android:alpha="0.10" />

    <!-- Decorative circle bottom-left -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-70dp"
        android:layout_marginStart="-70dp"
        android:background="@drawable/bg_circle_decoration"
        android:alpha="0.08" />

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="52dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <!-- Brand row: logo + name side by side -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginEnd="14dp"
                android:elevation="4dp">

                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/logo_circle_bg" />

                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:src="@drawable/medconnet_appiconv2"
                    android:scaleType="centerCrop"
                    android:contentDescription="CIT MedConnect Logo" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CIT MedConnect+"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Health. Our Priority."
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mascot — fills all remaining vertical space -->
        <ImageView
            android:id="@+id/mascotImage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/mascot_cit"
            android:scaleType="fitCenter"
            android:contentDescription="CIT Mascot" />

        <!-- Welcome text section (replaces feature chips) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your complete healthcare companion\nat CIT University."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book appointments, access medical records, and stay connected with CIT's health team — anytime, anywhere."
                android:textColor="#CCFFFFFF"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <!-- Sign In button (white solid) -->
        <Button
            android:id="@+id/signInButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="SIGN IN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary_red"
            android:background="@drawable/button_white_solid"
            android:layout_marginBottom="12dp" />

        <!-- Create Account button (white outline) -->
        <Button
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="CREATE ACCOUNT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_outline_white"
            android:layout_marginBottom="20dp" />

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CIT University · Cebu Institute of Technology"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
