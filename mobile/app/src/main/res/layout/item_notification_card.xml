<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/section_card_bg"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp"
    android:elevation="1dp">

    <!-- Type icon circle -->
    <LinearLayout
        android:id="@+id/iconContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/stat_icon_bg_blue"
        android:gravity="center"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/notifIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_bell"
            android:tint="#2196F3"
            android:contentDescription="Notification" />
    </LinearLayout>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/notifTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Notification"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Unread dot -->
            <View
                android:id="@+id/unreadDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/profile_avatar_bg"
                android:layout_marginStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/notifMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You have a new notification."
            android:textSize="11sp"
            android:textColor="#757575"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/notifTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Just now"
            android:textSize="10sp"
            android:textColor="#BDBDBD" />
    </LinearLayout>

    <!-- Delete button (admin) / Read indicator -->
    <LinearLayout
        android:id="@+id/btnDelete"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/action_btn_red_outline"
        android:gravity="center"
        android:layout_marginStart="8dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_delete"
            android:tint="#F44336"
            android:contentDescription="Delete" />
    </LinearLayout>

</LinearLayout>
