<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/section_card_bg"
    android:elevation="2dp"
    android:clipToOutline="true">

    <!-- Left status accent strip -->
    <View
        android:id="@+id/statusAccent"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="#2196F3" />

    <!-- Card content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- Row 1: Reason + Status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:id="@+id/appointmentReason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Medical Appointment"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/statusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scheduled"
                android:textSize="9sp"
                android:textStyle="bold"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/badge_scheduled_bg"
                android:textColor="#2196F3" />
        </LinearLayout>

        <!-- Row 2: Student info (admin-only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_user"
                android:tint="#BDBDBD"
                android:contentDescription="Student"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/appointmentUserId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="23-1111-111"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/appointmentUserName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Juan Santos"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Row 3: Date/Time · Location + Action buttons (matches student card style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_clock"
                android:tint="#BDBDBD"
                android:contentDescription="Time"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/appointmentDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="11sp"
                android:textColor="#757575"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                android:tint="#BDBDBD"
                android:contentDescription="Location"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/appointmentLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Main Clinic"
                android:textSize="11sp"
                android:textColor="#757575"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Action buttons (inline, same size as student card) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="6dp">

                <LinearLayout
                    android:id="@+id/btnView"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/action_btn_blue"
                    android:gravity="center">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_eye"
                        android:tint="#2196F3"
                        android:contentDescription="View" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnComplete"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/action_btn_green"
                    android:gravity="center"
                    android:layout_marginStart="5dp"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_check"
                        android:tint="#4CAF50"
                        android:contentDescription="Complete" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnReschedule"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/action_btn_amber"
                    android:gravity="center"
                    android:layout_marginStart="5dp"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="#FF8F00"
                        android:contentDescription="Reschedule" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCancel"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/action_btn_red_outline"
                    android:gravity="center"
                    android:layout_marginStart="5dp"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_close"
                        android:tint="#F44336"
                        android:contentDescription="Cancel" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
