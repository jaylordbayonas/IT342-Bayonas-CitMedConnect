<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_rounded_bg">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Manage Time Slots"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <LinearLayout
            android:id="@+id/closeBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/close_btn_bg"
            android:gravity="center">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_close"
                android:tint="#757575"
                android:contentDescription="Close" />
        </LinearLayout>
    </LinearLayout>

    <!-- Header divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <ScrollView
        android:id="@+id/manageSlotsScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- ===== CREATE NEW SLOT FORM ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/manage_slots_form_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <!-- Form title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create New Slot"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_red"
                    android:layout_marginBottom="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FFCDD2"
                    android:layout_marginBottom="14dp" />

                <!-- Date field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date *"
                    android:textSize="11sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/slotDateInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:minHeight="48dp"
                    android:background="@drawable/input_outline_bg"
                    android:hint="Tap to select date"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:textColorHint="#757575"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:focusable="false"
                    android:clickable="true"
                    android:cursorVisible="false"
                    android:singleLine="true"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="10dp"
                    android:drawableEnd="@drawable/ic_calendar"
                    android:drawableTint="#9E9E9E"
                    android:drawablePadding="8dp"
                    tools:ignore="HardcodedText" />

                <!-- Start Time / End Time row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Start Time *"
                            android:textSize="11sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/slotStartTimeInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/input_outline_bg"
                            android:hint="Tap to select"
                            android:textSize="13sp"
                            android:textColor="#212121"
                            android:textColorHint="#757575"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:singleLine="true"
                            android:importantForAutofill="no"
                            android:drawableEnd="@drawable/ic_clock"
                            android:drawableTint="#9E9E9E"
                            android:drawablePadding="8dp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="End Time"
                            android:textSize="11sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/slotEndTimeInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/input_outline_bg"
                            android:hint="Tap to select"
                            android:textSize="13sp"
                            android:textColor="#212121"
                            android:textColorHint="#757575"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:focusable="false"
                            android:clickable="true"
                            android:cursorVisible="false"
                            android:singleLine="true"
                            android:importantForAutofill="no"
                            android:drawableEnd="@drawable/ic_clock"
                            android:drawableTint="#9E9E9E"
                            android:drawablePadding="8dp"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Max Bookings / Location row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Max Bookings"
                            android:textSize="11sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginBottom="4dp" />

                        <EditText
                            android:id="@+id/slotMaxBookingsInput"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:minHeight="48dp"
                            android:background="@drawable/input_outline_bg"
                            android:text="1"
                            android:textSize="13sp"
                            android:textColor="#212121"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:inputType="number"
                            android:singleLine="true"
                            android:importantForAutofill="no"
                            tools:ignore="HardcodedText" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textSize="11sp"
                            android:textColor="#9E9E9E"
                            android:layout_marginBottom="4dp" />

                        <!-- Static location display -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/input_outline_bg"
                            android:gravity="center_vertical"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Main Clinic"
                                android:textSize="13sp"
                                android:textColor="#757575" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Add Time Slot button -->
                <LinearLayout
                    android:id="@+id/addSlotBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/button_primary_pill"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ Add Time Slot"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

            </LinearLayout>

            <!-- ===== AVAILABLE SLOTS SECTION ===== -->
            <TextView
                android:id="@+id/slotCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Slots (0)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic slot items -->
            <LinearLayout
                android:id="@+id/manageSlotsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty state for slots -->
            <LinearLayout
                android:id="@+id/emptyManagedSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/stat_icon_bg_amber"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="#FFC107"
                        android:contentDescription="No slots" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Slots Created Yet"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#424242"
                    android:gravity="center"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use the form above to create your first time slot."
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
