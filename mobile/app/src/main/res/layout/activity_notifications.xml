<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Red gradient header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_red_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Notifications"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <!-- Send button: admin only, hidden by default -->
                    <LinearLayout
                        android:id="@+id/sendNotifBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:orientation="horizontal"
                        android:background="@drawable/nav_item_active_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:src="@drawable/ic_bell"
                            android:tint="#FFFFFF"
                            android:contentDescription="Send"
                            android:layout_marginEnd="5dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Send"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your latest updates and alerts"
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF" />
            </LinearLayout>

            <!-- ── Filter tabs ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tabAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="All"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/filter_chip_active_bg"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabUnread"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Unread"
                    android:textSize="12sp"
                    android:textColor="#616161"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/filter_chip_inactive_bg"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tabRead"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Read"
                    android:textSize="12sp"
                    android:textColor="#616161"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:background="@drawable/filter_chip_inactive_bg" />

            </LinearLayout>

            <!-- ── Loading indicator ── -->
            <LinearLayout
                android:id="@+id/loadingState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="48dp"
                android:paddingBottom="32dp"
                android:visibility="gone">
                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminateTint="#8B1A1A" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading notifications..."
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- ── Empty state ── -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="60dp"
                android:paddingBottom="48dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/stat_icon_bg_red"
                    android:gravity="center"
                    android:layout_marginBottom="14dp">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_bell"
                        android:tint="#8B1A1A"
                        android:contentDescription="No notifications" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Notifications"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#424242"
                    android:gravity="center"
                    android:layout_marginBottom="6dp" />
                <TextView
                    android:id="@+id/emptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You're all caught up! No new notifications."
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"
                    android:gravity="center"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp" />
            </LinearLayout>

            <!-- ── Notifications container ── -->
            <LinearLayout
                android:id="@+id/notificationsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== FLOATING BOTTOM NAVIGATION (Notifications active) ===== -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_floating_bg"
        android:elevation="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:alpha="0.55" android:padding="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_home" android:tint="#FFFFFF"
                android:contentDescription="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAppointments"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:alpha="0.55" android:padding="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_appointment" android:tint="#FFFFFF"
                android:contentDescription="Appointments" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMedicalRecords"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:alpha="0.55" android:padding="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_records" android:tint="#FFFFFF"
                android:contentDescription="Records" />
        </LinearLayout>

        <!-- NOTIFICATIONS (active) -->
        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/nav_item_active_bg"
            android:padding="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_bell" android:tint="#FFFFFF"
                android:contentDescription="Notifications" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Alerts" android:textSize="9sp" android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center" android:alpha="0.55" android:padding="6dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_profile" android:tint="#FFFFFF"
                android:contentDescription="Profile" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
