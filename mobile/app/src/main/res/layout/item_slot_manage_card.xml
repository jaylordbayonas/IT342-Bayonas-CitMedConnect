<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/slot_item_manage_bg"
    android:paddingStart="14dp"
    android:paddingEnd="12dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_marginBottom="8dp">

    <!-- Slot info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/slotManageDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5/25/2026 - 10:30:00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/slotManageStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Main Clinic • Available"
            android:textSize="11sp"
            android:textColor="#9E9E9E" />
    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/btnSlotEdit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/action_btn_amber"
            android:gravity="center"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_edit"
                android:tint="#FF8F00"
                android:contentDescription="Edit Slot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSlotDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/action_btn_red_outline"
            android:gravity="center">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_delete"
                android:tint="#F44336"
                android:contentDescription="Delete Slot" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
