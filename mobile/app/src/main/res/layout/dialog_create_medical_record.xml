<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/dialog_rounded_bg">

    <!-- ── Header ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create Medical Record"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <LinearLayout
            android:id="@+id/closeBtn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/close_btn_bg"
            android:gravity="center">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_close"
                android:tint="#757575"
                android:contentDescription="Close" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <!-- ── Scrollable body — weight=1 keeps footer always visible ── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- ── STUDENT INFORMATION ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#8B1A1A"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STUDENT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8B1A1A"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Student *"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <FrameLayout
                android:id="@+id/studentSpinnerContainer"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_outline_bg"
                android:layout_marginBottom="20dp">
                <Spinner
                    android:id="@+id/studentSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="36dp"
                    android:clickable="true"
                    android:focusable="true" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_right"
                    android:rotation="90"
                    android:tint="#757575"
                    android:contentDescription="Expand"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>

            <!-- ── MEDICAL INFORMATION ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#8B1A1A"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MEDICAL INFORMATION"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8B1A1A"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnosis *"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/diagnosisInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Primary diagnosis"
                android:inputType="textCapSentences"
                android:background="@drawable/input_outline_bg"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Symptoms"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/symptomsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe symptoms..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="3"
                android:minHeight="52dp"
                android:background="@drawable/input_outline_bg"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Treatment"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/treatmentInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Describe the treatment plan..."
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="3"
                android:minHeight="52dp"
                android:background="@drawable/input_outline_bg"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:layout_marginBottom="12dp"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prescriptions (comma-separated)"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/prescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="e.g. Paracetamol 500mg, Ibuprofen"
                android:inputType="textCapSentences"
                android:background="@drawable/input_outline_bg"
                android:padding="12dp"
                android:textSize="13sp"
                android:textColor="#212121"
                android:textColorHint="#9E9E9E"
                android:layout_marginBottom="20dp"
                android:importantForAutofill="no" />

            <!-- ── VITAL SIGNS ── -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <View
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="#8B1A1A"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VITAL SIGNS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#8B1A1A"
                    android:letterSpacing="0.06" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood Pressure"
                        android:textSize="11sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp" />
                    <EditText
                        android:id="@+id/bpInput"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="120/80"
                        android:inputType="text"
                        android:background="@drawable/input_outline_bg"
                        android:padding="10dp"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:textColorHint="#9E9E9E"
                        android:importantForAutofill="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Heart Rate (bpm)"
                        android:textSize="11sp"
                        android:textColor="#757575"
                        android:layout_marginBottom="4dp" />
                    <EditText
                        android:id="@+id/hrInput"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="72"
                        android:inputType="number"
                        android:background="@drawable/input_outline_bg"
                        android:padding="10dp"
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:textColorHint="#9E9E9E"
                        android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ── Footer — always visible because ScrollView is weight=1 ── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F0F0F0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:gravity="end">

        <LinearLayout
            android:id="@+id/cancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/close_btn_bg"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#757575" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/createBtn"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/button_primary_pill"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_records"
                android:tint="#FFFFFF"
                android:contentDescription="Create"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/createBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Record"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
