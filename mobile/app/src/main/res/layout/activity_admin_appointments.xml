<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="96dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== PAGE HEADER (red gradient) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/gradient_red_bg"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="48dp"
                android:paddingBottom="20dp">

                <!-- Title row + Manage Slots button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Appointments"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF" />

                    <!-- Manage Slots button -->
                    <LinearLayout
                        android:id="@+id/manageSlotsBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:orientation="horizontal"
                        android:background="@drawable/button_outline_white"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Slots"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Subtitle -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage all appointments and time slots"
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF" />

            </LinearLayout>

            <!-- ===== SEARCH + FILTER SECTION ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp">

                <!-- Search field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:background="@drawable/search_field_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        android:tint="#BDBDBD"
                        android:contentDescription="Search"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/searchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Search by reason, student ID, name..."
                        android:textSize="13sp"
                        android:textColor="#212121"
                        android:textColorHint="#BDBDBD"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- Filter chips (horizontal scroll) — 5 statuses for admin -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/filterAll"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="All"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/filter_chip_active_bg"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filterScheduled"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Scheduled"
                            android:textSize="12sp"
                            android:textColor="#616161"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/filter_chip_inactive_bg"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filterCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Completed"
                            android:textSize="12sp"
                            android:textColor="#616161"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/filter_chip_inactive_bg"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filterSuccess"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Success"
                            android:textSize="12sp"
                            android:textColor="#616161"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/filter_chip_inactive_bg"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/filterCancelled"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Cancelled"
                            android:textSize="12sp"
                            android:textColor="#616161"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:background="@drawable/filter_chip_inactive_bg" />

                    </LinearLayout>
                </HorizontalScrollView>

            </LinearLayout>

            <!-- ===== APPOINTMENTS LIST ===== -->
            <LinearLayout
                android:id="@+id/appointmentsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp" />

            <!-- ===== EMPTY STATE ===== -->
            <LinearLayout
                android:id="@+id/emptyStateContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="60dp"
                android:paddingBottom="48dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:background="@drawable/stat_icon_bg_blue"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_calendar"
                        android:tint="#2196F3"
                        android:contentDescription="No appointments" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Appointments Found"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#424242"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/emptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No appointments have been booked yet."
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== FLOATING BOTTOM NAVIGATION (Appointments active) ===== -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:background="@drawable/nav_floating_bg"
        android:elevation="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.55"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home"
                android:tint="#FFFFFF"
                android:contentDescription="Home" />
        </LinearLayout>

        <!-- APPOINTMENTS (active) -->
        <LinearLayout
            android:id="@+id/navAppointments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/nav_item_active_bg"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_appointment"
                android:tint="#FFFFFF"
                android:contentDescription="Appointments" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Appts"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- MEDICAL RECORDS -->
        <LinearLayout
            android:id="@+id/navMedicalRecords"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.55"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_records"
                android:tint="#FFFFFF"
                android:contentDescription="Medical Records" />
        </LinearLayout>

        <!-- NOTIFICATIONS -->
        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.55"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="20dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_bell"
                    android:tint="#FFFFFF"
                    android:contentDescription="Notifications" />
                <View
                    android:id="@+id/navNotifBadge"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/nav_badge_bg"
                    android:layout_gravity="top|end"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0.55"
            android:padding="6dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_profile"
                android:tint="#FFFFFF"
                android:contentDescription="Profile" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
