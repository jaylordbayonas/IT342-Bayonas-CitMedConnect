<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/appointment_item_bg"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical">

    <!-- Icon circle -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/appt_icon_circle_bg"
        android:gravity="center">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_calendar"
            android:tint="@color/primary_red"
            android:contentDescription="Appointment" />
    </LinearLayout>

    <!-- Appointment details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/appointmentReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medical Appointment"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#212121" />

        <TextView
            android:id="@+id/appointmentDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Santos"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_clock"
                android:tint="#BDBDBD"
                android:contentDescription="Time"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/appointmentDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="May 26, 2026 at 12:41"
                android:textSize="11sp"
                android:textColor="#9E9E9E" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status badge -->
    <TextView
        android:id="@+id/appointmentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scheduled"
        android:textSize="10sp"
        android:textStyle="bold"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/badge_scheduled_bg"
        android:textColor="#2196F3"
        android:layout_marginStart="8dp" />

</LinearLayout>
